worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr crit;
events { worker_connections 1024; }
http {
    # Never log credentials, tokens, query strings, or internal headers.
    access_log off;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    client_max_body_size 1m;
    client_body_timeout 20s;
    proxy_connect_timeout 5s;
    proxy_send_timeout 20s;
    proxy_read_timeout 25s;
    server_tokens off;

    # Trust one actual Traefik peer, never the shared overlay subnet. With
    # recursion off, only the last X-Forwarded-For address is considered.
    set_real_ip_from ${TRUSTED_PROXY_IP}/32;
    real_ip_header X-Forwarded-For;
    real_ip_recursive off;
    geo $realip_remote_addr $trusted_proxy {
        default 0;
        ${TRUSTED_PROXY_IP}/32 1;
    }

    # Docker's embedded DNS permits the web service to start/redeploy later.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    server {
        listen 8080 default_server;
        server_name _;
        return 444;
    }
    server {
        listen 8080;
        server_name painel.alessandraguinosa.adv.br;

        # Refuse direct requests and requests without a usable forwarded IP.
        if ($trusted_proxy = 0) { return 403; }
        if ($remote_addr = $realip_remote_addr) { return 403; }

        location / {
            set $web_upstream "${WEB_UPSTREAM_HOST}";
            proxy_pass http://$web_upstream:3000;
            proxy_http_version 1.1;
            proxy_set_header Host painel.alessandraguinosa.adv.br;
            proxy_set_header X-Forwarded-Host painel.alessandraguinosa.adv.br;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Real-IP "";
            proxy_set_header X-Advocacia-Client-IP $remote_addr;
            proxy_set_header X-Advocacia-Ingress-Secret "${AUTH_INGRESS_SECRET}";
        }
    }
}
