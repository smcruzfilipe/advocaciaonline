worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr crit;
events { worker_connections 1024; }
http {
    # Authentication tokens and internal headers must never enter access logs.
    access_log off;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    client_max_body_size 1m;
    client_body_timeout 20s;
    proxy_connect_timeout 5s;
    proxy_send_timeout 20s;
    proxy_read_timeout 25s;
    server_tokens off;
    server {
        listen 0.0.0.0:3443 ssl;
        server_name ${LOCAL_APP_HOST};
        ssl_certificate /run/tls/server.crt;
        ssl_certificate_key /run/tls/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        add_header Strict-Transport-Security "max-age=31536000" always;
        location / {
            proxy_pass http://web:3000;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP "";
            proxy_set_header X-Advocacia-Client-IP $remote_addr;
            proxy_set_header X-Advocacia-Ingress-Secret "${AUTH_INGRESS_SECRET}";
        }
    }
}
