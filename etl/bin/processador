#!/usr/bin/env ruby
require "bundler/setup"
require "json"
require_relative "../lib/processador/runner"

def positive_integer(name, default, maximum: nil)
  value = ENV.fetch(name, default.to_s)
  raise ArgumentError, "#{name} must be a positive integer" unless value.match?(/\A[0-9]+\z/) && value.to_i.positive?
  number = value.to_i
  raise ArgumentError, "#{name} exceeds its permitted limit" if maximum && number > maximum
  number
end

begin
  raise ArgumentError, "usage: processador JOB_UUID" unless ARGV.length == 1
  runner = Processador::Runner.new(
    database_url: ENV.fetch("PROCESSADOR_DATABASE_URL"),
    attempts: positive_integer("COLETA_TENTATIVAS_POR_CAMINHO", 3, maximum: 3),
    backoff_first: positive_integer("COLETA_BACKOFF_APOS_FALHA_1_SEGUNDOS", 60),
    backoff_second: positive_integer("COLETA_BACKOFF_APOS_FALHA_2_SEGUNDOS", 300)
  )
  result = runner.call(ARGV.fetch(0))
  puts JSON.generate(result)
  exit(result.fetch("state") == "succeeded" ? 0 : 1)
rescue KeyError, ArgumentError => error
  warn error.message
  exit 1
rescue StandardError => error
  warn "processing failed (#{error.class})"
  exit 1
end
